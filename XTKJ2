<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nathan — Teknik Komputer & Jaringan</title>
<style>
  :root{
    --bg: #10141A;
    --surface: #171E27;
    --surface-2: #1E2731;
    --line: #2A3540;
    --text: #E7E6E0;
    --text-dim: #8B96A3;
    --accent: #4FD1C5;
    --accent-2: #FFB03B;
    --mono: 'JetBrains Mono', 'Courier New', monospace;
    --sans: 'Manrope', -apple-system, sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.6;
    overflow-x:hidden;
  }
  ::selection{background:var(--accent);color:var(--bg);}

  /* ---------- Utility ---------- */
  .wrap{max-width:960px;margin:0 auto;padding:0 24px;}
  .prompt{font-family:var(--mono);color:var(--accent);}
  .dim{color:var(--text-dim);}
  .status-dot{
    display:inline-block;width:8px;height:8px;border-radius:50%;
    background:var(--accent);box-shadow:0 0 8px var(--accent);
    animation:pulse 2s ease-in-out infinite;
  }
  @keyframes pulse{
    0%,100%{opacity:1;}
    50%{opacity:.4;}
  }

  /* ---------- Nav ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(16,20,26,.85);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav{
    display:flex;justify-content:space-between;align-items:center;
    padding:16px 24px;max-width:960px;margin:0 auto;
  }
  .logo{font-family:var(--mono);font-weight:700;font-size:15px;letter-spacing:.5px;}
  .logo span{color:var(--accent);}
  nav a.navlink{
    color:var(--text-dim);text-decoration:none;font-size:14px;
    margin-left:28px;transition:color .2s;
  }
  nav a.navlink:hover{color:var(--text);}
  .nav-links{display:flex;align-items:center;}
  .nav-cta{
    font-family:var(--mono);font-size:13px;
    background:var(--accent);color:var(--bg);
    padding:8px 16px;border-radius:6px;font-weight:700;
    text-decoration:none;margin-left:28px;
  }

  /* ---------- Hero ---------- */
  .hero{
    padding:120px 24px 90px;
    max-width:960px;margin:0 auto;
    position:relative;
  }
  .terminal-line{
    font-family:var(--mono);font-size:14px;color:var(--text-dim);
    margin-bottom:18px;display:flex;align-items:center;gap:8px;
  }
  .cursor{
    display:inline-block;width:8px;height:16px;background:var(--accent);
    animation:blink 1s step-end infinite;
  }
  @keyframes blink{50%{opacity:0;}}
  h1.hero-title{
    font-family:var(--mono);
    font-size:clamp(40px,8vw,76px);
    font-weight:700;
    letter-spacing:-1px;
    line-height:1;
    margin-bottom:14px;
  }
  .hero-role{
    font-size:clamp(18px,3vw,24px);
    color:var(--accent);
    font-weight:600;
    margin-bottom:22px;
  }
  .hero-desc{
    max-width:520px;color:var(--text-dim);font-size:16px;margin-bottom:36px;
  }
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    font-family:var(--mono);font-size:14px;font-weight:700;
    padding:14px 26px;border-radius:8px;text-decoration:none;
    display:inline-flex;align-items:center;gap:8px;
    transition:transform .15s, box-shadow .15s;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{
    background:var(--accent);color:var(--bg);
  }
  .btn-primary:hover{box-shadow:0 8px 24px -8px rgba(79,209,197,.6);}
  .btn-ghost{
    background:transparent;color:var(--text);border:1px solid var(--line);
  }
  .btn-ghost:hover{border-color:var(--accent);color:var(--accent);}

  /* network topology visual */
  .net-map{
    margin-top:70px;
    position:relative;
    height:180px;
  }
  .net-map svg{width:100%;height:100%;}
  .node-label{
    font-family:var(--mono);font-size:11px;fill:var(--text-dim);
  }

  /* ---------- Section shared ---------- */
  section{padding:80px 24px;border-top:1px solid var(--line);}
  .section-inner{max-width:960px;margin:0 auto;}
  .eyebrow{
    font-family:var(--mono);font-size:12px;color:var(--accent);
    text-transform:uppercase;letter-spacing:2px;margin-bottom:10px;
  }
  h2.section-title{
    font-family:var(--mono);font-size:clamp(26px,4vw,36px);
    margin-bottom:36px;letter-spacing:-.5px;
  }

  /* ---------- About / stats ---------- */
  .about-grid{
    display:grid;grid-template-columns:1.2fr .8fr;gap:48px;
  }
  .about-text{color:var(--text-dim);font-size:16px;}
  .about-text strong{color:var(--text);}
  .stats{
    display:flex;flex-direction:column;gap:0;
    border:1px solid var(--line);border-radius:10px;overflow:hidden;
  }
  .stat-row{
    display:flex;justify-content:space-between;align-items:center;
    padding:16px 20px;font-family:var(--mono);font-size:13px;
    border-bottom:1px solid var(--line);
    background:var(--surface);
  }
  .stat-row:last-child{border-bottom:none;}
  .stat-row .val{color:var(--accent);font-weight:700;font-size:16px;}

  /* ---------- Skills topology ---------- */
  .skills-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:16px;
  }
  .skill-node{
    background:var(--surface);border:1px solid var(--line);
    border-radius:10px;padding:20px;transition:border-color .2s, transform .2s;
  }
  .skill-node:hover{border-color:var(--accent);transform:translateY(-3px);}
  .skill-node-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;}
  .skill-name{font-weight:700;font-size:15px;}
  .signal{display:flex;gap:3px;align-items:flex-end;}
  .signal i{
    display:block;width:3px;background:var(--line);border-radius:1px;
  }
  .signal i:nth-child(1){height:6px;}
  .signal i:nth-child(2){height:10px;}
  .signal i:nth-child(3){height:14px;}
  .skill-node.strong .signal i{background:var(--accent);}
  .skill-desc{font-size:13px;color:var(--text-dim);}

  /* ---------- Services ---------- */
  .services-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:18px;
  }
  .service-card{
    background:var(--surface);border:1px solid var(--line);border-radius:10px;
    padding:26px;
  }
  .service-icon{
    width:36px;height:36px;border-radius:8px;background:var(--surface-2);
    display:flex;align-items:center;justify-content:center;margin-bottom:16px;
    color:var(--accent);
  }
  .service-card h3{font-size:16px;margin-bottom:8px;}
  .service-card p{font-size:13.5px;color:var(--text-dim);}

  /* ---------- Contact / WA box ---------- */
  .contact-panel{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
  }
  .panel-bar{
    display:flex;align-items:center;gap:8px;
    padding:12px 18px;border-bottom:1px solid var(--line);
    background:var(--surface-2);
  }
  .panel-bar .dot{width:9px;height:9px;border-radius:50%;background:var(--line);}
  .panel-bar span.title{
    font-family:var(--mono);font-size:12px;color:var(--text-dim);margin-left:6px;
  }
  .panel-body{
    padding:36px;
    display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;
  }
  .panel-status{
    font-family:var(--mono);font-size:13px;color:var(--text-dim);margin-bottom:8px;
    display:flex;align-items:center;gap:8px;
  }
  .panel-status .status-dot{background:#4ADE80;box-shadow:0 0 8px #4ADE80;}
  .wa-number{
    font-family:var(--mono);font-size:clamp(22px,4vw,30px);font-weight:700;
    letter-spacing:.5px;margin-bottom:6px;
  }
  .wa-sub{color:var(--text-dim);font-size:14px;}
  .btn-wa{
    background:#25D366;color:#0a1a12;font-family:var(--mono);
    font-weight:700;font-size:15px;padding:16px 28px;border-radius:10px;
    text-decoration:none;display:inline-flex;align-items:center;gap:10px;
    white-space:nowrap;transition:transform .15s,box-shadow .15s;
  }
  .btn-wa:hover{transform:translateY(-2px);box-shadow:0 10px 26px -10px rgba(37,211,102,.55);}

  @media(max-width:640px){
    .panel-body{grid-template-columns:1fr;text-align:left;}
    .about-grid{grid-template-columns:1fr;}
    .nav-links a.navlink{display:none;}
  }

  /* ---------- Floating WA button ---------- */
  .fab-wa{
    position:fixed;bottom:24px;right:24px;z-index:60;
    width:58px;height:58px;border-radius:50%;
    background:#25D366;display:flex;align-items:center;justify-content:center;
    box-shadow:0 10px 30px -8px rgba(37,211,102,.7);
    text-decoration:none;
    animation:fab-pulse 2.5s ease-in-out infinite;
  }
  @keyframes fab-pulse{
    0%,100%{box-shadow:0 10px 30px -8px rgba(37,211,102,.7);}
    50%{box-shadow:0 10px 36px -4px rgba(37,211,102,.95);}
  }

  footer{
    padding:36px 24px;text-align:center;
    font-family:var(--mono);font-size:12px;color:var(--text-dim);
    border-top:1px solid var(--line);
  }
  footer .status-dot{margin-right:6px;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.001ms !important;animation-iteration-count:1 !important;}
    html{scroll-behavior:auto;}
  }

  a:focus-visible, button:focus-visible{
    outline:2px solid var(--accent);outline-offset:3px;
  }
</style>
</head>
