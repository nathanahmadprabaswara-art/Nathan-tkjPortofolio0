<script>
  const text = "menghubungkan perangkat, satu jaringan pada satu waktu";
  const el = document.getElementById('typed');
  let i = 0;
  function type(){
    if(i <= text.length){
      el.textContent = text.slice(0, i);
      i++;
      setTimeout(type, 45);
    }
  }
  type();
</script>

